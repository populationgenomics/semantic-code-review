{
  "name": "semantic-code-review-frontend",
  "version": "0.4.0",
  "private": true,
  "description": "Frontend assets for the scr diff viewer. Bundled by esbuild (boot.ts -> viewer/assets/viewer.js) and served as a static asset by review/server.py.",
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild semantic_code_review/viewer/assets/boot.ts --bundle --format=iife --target=es2020 --outfile=semantic_code_review/viewer/assets/viewer.js",
    "typecheck": "tsc --noEmit",
    "build:watch": "npm run bundle -- --watch",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.6.4",
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "markdown-it": "15.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
