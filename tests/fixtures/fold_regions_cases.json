[
  {
    "name": "changed method under an unchanged class",
    "path": "a.py",
    "head": "class Foo:\n    def bar(self):\n        if x:\n            return 2\n        return 0\n\n    def qux(self):\n        return 9\n",
    "base": "class Foo:\n    def bar(self):\n        if x:\n            return 1\n        return 0\n\n    def qux(self):\n        return 9\n",
    "hunks": [
      {
        "header": "@@ -1,5 +1,5 @@",
        "old_start": 1,
        "old_count": 5,
        "new_start": 1,
        "new_count": 5,
        "body": " class Foo:\n     def bar(self):\n         if x:\n-            return 1\n+            return 2\n         return 0\n"
      }
    ],
    "expected": [
      {
        "context": "both",
        "right_start": 1,
        "right_end": 8,
        "left_start": 1,
        "left_end": 8,
        "has_changes": true,
        "qualified_name": "Foo",
        "kind": "class"
      },
      {
        "context": "both",
        "right_start": 2,
        "right_end": 5,
        "left_start": 2,
        "left_end": 5,
        "has_changes": true,
        "qualified_name": "Foo.bar",
        "kind": "function"
      },
      {
        "context": "right",
        "right_start": 7,
        "right_end": 8,
        "left_start": null,
        "left_end": null,
        "has_changes": false,
        "qualified_name": "Foo.qux",
        "kind": "function"
      }
    ]
  },
